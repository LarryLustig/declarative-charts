{
  "name": "declarative-charts",
  "version": "0.1.0",
  "description": "Create beautiful charts using declarative HTML elements. Bar, line, pie, funnel charts with accessibility, palettes, and responsive design.",
  "type": "module",
  "main": "./dist/declarative-charts.umd.cjs",
  "module": "./dist/declarative-charts.js",
  "types": "./dist/index.d.ts",
  "customElements": "custom-elements.json",
  "unpkg": "./dist/declarative-charts.standalone.js",
  "jsdelivr": "./dist/declarative-charts.standalone.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/declarative-charts.js",
      "require": "./dist/declarative-charts.umd.cjs"
    },
    "./standalone": {
      "types": "./dist/index.d.ts",
      "import": "./dist/declarative-charts.standalone.js"
    }
  },
  "//sideEffects": "Defining custom elements IS the side effect. Marking this package side-effect-free lets bundlers drop `import 'declarative-charts'` entirely, registering nothing and rendering a blank page with no error.",
  "sideEffects": [
    "*.js",
    "*.cjs"
  ],
  "files": [
    "dist",
    "custom-elements.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.config.standalone.ts && node build/minify-standalone.mjs && tsc -p tsconfig.build.json && npm run analyze",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:report": "playwright show-report test/visual/report",
    "bench": "node test/visual/bench.mjs",
    "analyze": "cem analyze --litelement --globs \"src/**/*.ts\" --outdir . && node build/compact-manifest.mjs",
    "test:package": "node test/package/smoke.mjs",
    "prepublishOnly": "npm run test:run && npm run build && npm run test:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LarryLustig/declarative-charts.git"
  },
  "bugs": {
    "url": "https://github.com/LarryLustig/declarative-charts/issues"
  },
  "homepage": "https://github.com/LarryLustig/declarative-charts#readme",
  "keywords": [
    "charts",
    "web-components",
    "lit",
    "declarative",
    "visualization",
    "bar-chart",
    "line-chart",
    "data-visualization",
    "hypermedia",
    "no-build",
    "server-rendered",
    "htmx",
    "html-first",
    "django",
    "rails"
  ],
  "author": "Lawrence Lustig <larrylustig@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@playwright/test": "^1.57.0",
    "@vitest/coverage-v8": "^4.0.16",
    "esbuild": "^0.21.5",
    "happy-dom": "^20.0.11",
    "lit": "^3.1.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^4.0.16"
  }
}
