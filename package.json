{
  "name": "declarative-charts",
  "version": "0.1.0",
  "description": "Create beautiful charts using declarative HTML elements. Bar, line, pie, funnel charts with accessibility, palettes, and responsive design.",
  "type": "module",
  "main": "./dist/declarative-charts.umd.cjs",
  "module": "./dist/declarative-charts.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/declarative-charts.js",
      "require": "./dist/declarative-charts.umd.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:report": "playwright show-report test/visual/report",
    "bench": "node test/visual/bench.mjs",
    "prepublishOnly": "npm run test:run && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_USERNAME/decl-charts.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/decl-charts/issues"
  },
  "homepage": "https://github.com/YOUR_USERNAME/decl-charts#readme",
  "keywords": [
    "charts",
    "web-components",
    "lit",
    "declarative",
    "visualization",
    "bar-chart",
    "line-chart",
    "data-visualization"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "dependencies": {
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@vitest/coverage-v8": "^4.0.16",
    "happy-dom": "^20.0.11",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^4.0.16"
  }
}
