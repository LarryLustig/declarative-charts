node_modules/

# Build output
dist/
*.local

# Generated by `npm run analyze`, shipped via package.json `files`.
# Regenerated on every build and before every publish, so committing it
# would only add a 1.2 MB single-line diff to the history.
custom-elements.json

# Built example gallery (npm run build:site)
site/

# Vite's dependency-resolution cache
.vite/

# Test coverage
coverage/

# Playwright test artifacts (keep snapshots, ignore results/reports)
test/visual/test-results/
test/visual/report/
playwright-report/

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.local
.env.*.local
