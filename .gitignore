# Dependencies
node_modules/

# Build output
dist/
*.local

# Generated by `npm run analyze`, shipped via package.json `files`.
# Regenerated on every build and before every publish, so committing it
# would only add a 1.2 MB single-line diff to the history.
custom-elements.json

# Built example gallery (npm run build:site)
site/

# Vite's dependency-resolution cache
.vite/

# Test coverage
coverage/

# Playwright test artifacts (keep snapshots, ignore results/reports)
test/visual/test-results/
test/visual/report/
playwright-report/

# Per-machine Claude Code settings. The .local.json suffix is the convention
# for "this machine only"; a shared .claude/settings.json would be committed.
.claude/settings.local.json

# The launch/outreach plan. Deliberately untracked: it is a plan about the
# project's audience rather than its code, and publishing an objection-handling
# script in the repo you are about to post about is its own kind of own-goal.
docs/launch.md

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.local
.env.*.local
